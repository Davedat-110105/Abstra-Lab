# Copy to .env and adjust before: docker compose up --build -d

# Web image tag for build/push workflows
ASTRA_FRONTEND_IMAGE=astra-lab-frontend:latest
FRONTEND_PUBLISH_PORT=3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Next.js database. Use the Vercel/free-tier Postgres connection string here.
DATABASE_URL=postgresql://astra:astra_db_password@localhost:5432/astra
AUTH_SECRET=change-me-to-a-long-random-string
TELEMETRY_INGEST_TOKEN=change-me-telemetry-token

# PostgreSQL
POSTGRES_DB=astra
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=55432
