# Copy to .env and adjust before: docker compose up --build -d

# Web image tag for build/push workflows
ASTRA_WEB_IMAGE=astra-lab-web:latest

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_STATICFILES_MANIFEST=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TELEMETRY_INGEST_TOKEN=change-me-telemetry-token

# Optional first-run admin (created only if user does not exist)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=AstraAdmin2026

# PostgreSQL
POSTGRES_DB=astra
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SeaweedFS S3 (internal service DNS names)
SEAWEEDFS_S3_ENDPOINT_URL=http://seaweedfs-s3:8333
SEAWEEDFS_S3_ACCESS_KEY=astra_access_key
SEAWEEDFS_S3_SECRET_KEY=astra_secret_key
SEAWEEDFS_S3_BUCKET_NAME=astra-lab
SEAWEEDFS_S3_REGION_NAME=us-east-1
SEAWEEDFS_S3_USE_SSL=0
SEAWEEDFS_S3_VERIFY_SSL=0

# Set to 1 on first deploy to catalog ./references into the library DB
IMPORT_LIBRARY=1

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
