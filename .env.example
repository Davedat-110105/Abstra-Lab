# Copy to .env and adjust before: docker compose up --build -d

# Web image tag for build/push workflows
ASTRA_FRONTEND_IMAGE=astra-lab-frontend:latest
FRONTEND_PUBLISH_PORT=3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Next.js database. Use the Vercel/free-tier Postgres connection string here.
DATABASE_URL=postgresql://astra:astra_db_password@localhost:5432/astra
# Required in production. Use a long random string, e.g. `openssl rand -base64 48`.
# The app refuses to start a session in production if this is unset or left at
# the insecure "local-next-session-secret" default.
AUTH_SECRET=change-me-to-a-long-random-string
# Set to 1 when serving over HTTPS so session cookies are marked Secure.
# Defaults to Secure automatically when NODE_ENV=production.
AUTH_SECURE_COOKIE=0
# Bearer token required by POST /api/telemetry/frames (fails closed in production if unset).
TELEMETRY_INGEST_TOKEN=change-me-telemetry-token

# File uploads (POST /api/upload). Uploads are split by visibility:
#   public  -> public/<name>  (permanent public URL; only the public/ prefix is world-readable)
#   private -> private/<name> (member-only; served via GET /api/files/<key> after requireUser)
# `visibility` defaults to private, so nothing is exposed unless the caller opts in.
# Without S3_BUCKET, only PUBLIC uploads work (local filesystem); private uploads are refused.
# Credentials use the standard AWS chain — set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# (or an IAM role / profile). On Vercel, add these in Project Settings → Environment Variables.
S3_BUCKET=
AWS_REGION=ca-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional CDN/custom domain in front of the PUBLIC prefix (e.g. CloudFront). No trailing slash.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# PostgreSQL
POSTGRES_DB=astra
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=55432
