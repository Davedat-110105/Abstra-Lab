# SeaweedFS S3 gateway — set these to store uploads in object storage.
# Leave SEAWEEDFS_S3_ENDPOINT_URL empty to keep local filesystem storage (dev/tests).
SEAWEEDFS_S3_ENDPOINT_URL=http://127.0.0.1:8333
SEAWEEDFS_S3_ACCESS_KEY=your-access-key
SEAWEEDFS_S3_SECRET_KEY=your-secret-key
SEAWEEDFS_S3_BUCKET_NAME=astra-lab
SEAWEEDFS_S3_REGION_NAME=us-east-1
SEAWEEDFS_S3_USE_SSL=0
SEAWEEDFS_S3_VERIFY_SSL=0